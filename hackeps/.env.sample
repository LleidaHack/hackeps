PORT=3000

# Local API origin; do not include /docs or /v1.
REACT_APP_DOMAIN=http://localhost:8000

# Edition selected explicitly; missing editions never use a previous year.
REACT_APP_HACKEPS_YEAR=2026

# 1 = publish only the waiting page (plus /terms and /privacy); anything else
# redirects to /. 0 = publish the full site. Production sets this on Vercel.
REACT_APP_LAUNCH_PENDING=1

# "true" logs API responses to the console (never credentials). The code
# compares against the string "true"; 1 or yes do nothing.
REACT_APP_DEBUG=false

# 0 shows the "aquesta pàgina és de proves" banner on the full site.
REACT_APP_MAIN=1

# 1 plays the intro animation on the full-site home (at most once every 2 h).
REACT_APP_HERO_ANIMATED=1
