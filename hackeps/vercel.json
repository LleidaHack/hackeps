{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; font-src 'self' https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.lleidahack.dev https://va.vercel-scripts.com https://vitals.vercel-insights.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "preview.hackeps.dev"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/entrada/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/hackeps",
      "destination": "https://hackeps.dev/",
      "permanent": true
    },
    {
      "source": "/hackeps/:path*",
      "destination": "https://hackeps.dev/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "lleidahack.dev"
        }
      ],
      "destination": "https://hackeps.dev/:path*",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.lleidahack.dev"
        }
      ],
      "destination": "https://hackeps.dev/:path*",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.hackeps.dev"
        }
      ],
      "destination": "https://hackeps.dev/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/entrada/imatges/:path*",
      "destination": "https://backend.main.lleidahack.dev/static/images/:path*"
    },
    {
      "source": "/entrada/:eventId/:code/qr.png",
      "destination": "https://backend.main.lleidahack.dev/v1/event/:eventId/ticket/:code/qr.png"
    },
    {
      "source": "/entrada/:eventId/:code/apple.pkpass",
      "destination": "https://backend.main.lleidahack.dev/v1/event/:eventId/ticket/:code/apple.pkpass"
    },
    {
      "source": "/entrada/:eventId/:code",
      "destination": "https://backend.main.lleidahack.dev/v1/event/:eventId/ticket/:code/page"
    }
  ]
}
